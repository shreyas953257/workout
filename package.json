{
  "name": "forge-workout",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Forge — a gamified workout system built on top of the Markdown training library in this repository.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc -b"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
